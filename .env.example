# Copy to .env.local and fill in.
#
# Both values are safe to expose — Vite inlines every VITE_* variable into the
# built JavaScript, so treat them as public. Authorisation is enforced by
# Postgres row-level security, never by hiding this key.
#
# For a local stack, run `npx supabase status` and use API_URL and
# PUBLISHABLE_KEY. The values below are the defaults the local stack prints.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
